# Copia este archivo como .env y rellena los valores

# Clave secreta para JWT (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esto-por-una-clave-segura

# Groq (IA en la nube) — obtén tu API key en https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-8b-27b

# Ollama (IA local) — requiere Ollama instalado en http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
